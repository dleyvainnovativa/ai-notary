{
    "schema_version": "1.0.0",
    "global_rules": {
        "date_format": "YYYY-MM-DD",
        "number_format": "decimal",
        "empty_values": [
            null,
            ""
        ],
        "normalization_rules": [
            "Return enum values exactly as defined",
            "Remove currency symbols from numbers",
            "Convert dates to YYYY-MM-DD",
            "Return null when value is missing",
            "Do not infer missing data"
        ]
    },
    "fields": {
        "numero_escritura": {
            "type": "text",
            "label": "Número de escritura",
            "required": true,
            "ai_description": "Número de escritura pública"
        },
        "fecha_firma_escritura": {
            "type": "date",
            "label": "Fecha de firma",
            "required": true,
            "ai_description": "Fecha de firma de la escritura pública"
        },
        "tipo_inmueble": {
            "type": "select",
            "label": "Tipo de inmueble",
            "required": true,
            "source": "catalogo_inmuebles"
        },
        "especifica_inmueble": {
            "type": "text",
            "label": "Especificar inmueble",
            "required_if": {
                "tipo_inmueble": "9"
            }
        },
        "avaluo_inmueble": {
            "type": "number",
            "label": "Avalúo del inmueble",
            "default_if_missing": 0,
            "required": true,
            "ai_description": "Avalúo de lo que REALMENTE se transmite. Si es nuda propiedad, usufructo o un porcentaje, llena también valor_calculo; el sistema calcula este campo."
        },
        "monto_operacion": {
            "type": "number",
            "label": "Monto de la operación",
            "required": true,
            "default_if_missing": 0,
            "ai_description": "Precio o contraprestación pactada en la escritura por lo que se adquiere, solo dígitos. 0 si la adquisición es gratuita (donación, herencia, legado, adjudicación por herencia, cesión gratuita)."
        },
        "valor_calculo": {
            "type": "object",
            "ai_description": "Desglose para que el SISTEMA calcule el valor fiscal de lo que realmente se transmite (nuda propiedad, usufructo, porcentajes). No multipliques: solo extrae las partes.",
            "items": {
                "derecho_transmitido": {
                    "type": "text",
                    "ai_description": "'pleno_dominio' (propiedad completa), 'nuda_propiedad', 'usufructo' o 'parcial' (un porcentaje de la propiedad o de derechos de copropiedad)."
                },
                "valor_total": {
                    "type": "number",
                    "ai_description": "Valor del 100% del inmueble para efectos fiscales (avalúo, valor catastral o valor fiscal), solo dígitos. Ej. '$5,131,600.000' → 5131600."
                },
                "valor_explicito": {
                    "type": "number",
                    "ai_description": "Monto que la escritura asigna EXPRESAMENTE al derecho transmitido (ej. 'correspondiendo a la nuda propiedad la cantidad de $2,565,800.00' → 2565800). null si no lo dice."
                },
                "porcentajes": {
                    "type": "array",
                    "ai_description": "Cada porcentaje que la escritura aplica al valor, en el orden en que se aplican. [] si no hay.",
                    "items": {
                        "porcentaje": {
                            "type": "number",
                            "ai_description": "Ej. 50 para 50%."
                        },
                        "concepto": {
                            "type": "text",
                            "ai_description": "A qué se refiere: 'nuda propiedad', 'copropiedad', 'usufructo'…"
                        }
                    }
                }
            }
        },
        "enajenantes": {
            "type": "array",
            "items": {
                "tipo_enajenante": {
                    "type": "select",
                    "required": true,
                    "source": "catalogo_tipos_domicilio"
                },
                "rfc": {
                    "type": "text",
                    "required": true,
                    "validation": {
                        "format": "rfc"
                    },
                    "aliases": [
                        "rfc",
                        "registro federal de contribuyentes"
                    ]
                },
                "nombre": {
                    "type": "text",
                    "required": true
                },
                "apellido_paterno": {
                    "type": "text"
                },
                "apellido_materno": {
                    "type": "text"
                },
                "curp": {
                    "type": "text",
                    "required_if": {
                        "tipo_enajenante": "1"
                    },
                    "validation": {
                        "format": "curp"
                    }
                },
                "razon_social": {
                    "type": "text",
                    "required_when": {
                        "field": "rfc",
                        "rule": "rfc invalid or generic moral"
                    }
                },
                "nacionalidad": {
                    "type": "select",
                    "source": "catalogo_nacionalidad",
                    "required_if": {
                        "tipo_enajenante": "2"
                    }
                },
                "fecha_nacimiento": {
                    "type": "date",
                    "required_if": {
                        "tipo_enajenante": "2"
                    }
                },
                "documento_oficial": {
                    "type": "text",
                    "required_if": {
                        "tipo_enajenante": "2"
                    }
                },
                "folio": {
                    "type": "text",
                    "required_if": {
                        "tipo_enajenante": "2"
                    }
                }
            }
        },
        "adquirientes": {
            "type": "array",
            "items": {
                "tipo_adquiriente": {
                    "required": true,
                    "type": "select",
                    "source": "catalogo_tipos_domicilio"
                },
                "rfc": {
                    "type": "text",
                    "required": true,
                    "validation": {
                        "format": "rfc"
                    },
                    "aliases": [
                        "rfc",
                        "registro federal de contribuyentes"
                    ]
                },
                "nombre": {
                    "type": "text"
                },
                "apellido_paterno": {
                    "type": "text"
                },
                "apellido_materno": {
                    "type": "text"
                },
                "curp": {
                    "type": "text",
                    "required_if": {
                        "tipo_adquiriente": "1"
                    },
                    "validation": {
                        "format": "curp"
                    }
                },
                "razon_social": {
                    "type": "text",
                    "required_when": {
                        "field": "rfc",
                        "rule": "rfc invalid or generic moral"
                    }
                },
                "nacionalidad": {
                    "type": "select",
                    "source": "catalogo_nacionalidad",
                    "required_if": {
                        "tipo_adquiriente": "2"
                    }
                },
                "fecha_nacimiento": {
                    "type": "date",
                    "required_if": {
                        "tipo_adquiriente": "2"
                    }
                },
                "documento_oficial": {
                    "type": "text",
                    "required_if": {
                        "tipo_adquiriente": "2"
                    }
                },
                "folio": {
                    "type": "text",
                    "required_if": {
                        "tipo_adquiriente": "2"
                    }
                }
            }
        }
    }
}