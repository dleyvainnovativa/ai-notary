{
  "slug": "avisos_uif",
  "version": "1",
  "name": "Avisos UIF",
  "active": true,
  "exports": [
    "xml",
    "txt"
  ],
  "catalogs_used": [
    "catalogo_tipo_aviso",
    "catalogo_tipo_operacion",
    "catalogo_moneda",
    "catalogo_instrumento_monetario",
    "catalogo_tipo_persona",
    "catalogo_caracter_persona",
    "catalogo_nacionalidad",
    "catalogo_datos_informativos"
  ],
  "controller_class": "Modules\\AvisosUif\\V1\\Controller",
  "exporter_class": "Modules\\AvisosUif\\V1\\Exporter",
  "importer_class": "Modules\\AvisosUif\\V1\\Importer",
  "references": {
    "deed_date": [
      "escritura.operaciones.*.fecha_operacion"
    ],
    "address_keys": [
      "domicilio"
    ]
  },
  "append": {
    "array": "operaciones",
    "input": "escritura",
    "enabled_when": {
      "operaciones_acumuladas": "1"
    },
    "label": "Agregar escritura (operación acumulada)"
  }
}
