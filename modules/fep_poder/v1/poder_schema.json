{
  "schema_version": "1.0.0",
  "global_rules": {
    "date_format": "YYYY-MM-DD",
    "number_format": "decimal",
    "normalization_rules": [
      "Return catalog values exactly as the catalog code (string).",
      "Convert dates to YYYY-MM-DD.",
      "Return null when a value is missing; do not infer.",
      "Names in UPPERCASE without accents."
    ]
  },
  "fields": {
    "referencia_aviso": { "type": "text", "ai_description": "Referencia del aviso; usa el número de instrumento si no hay otra." },
    "prioridad": { "type": "select", "source": "catalogo_prioridad" },
    "alerta": {
      "type": "object",
      "fields": {
        "tipo_alerta": { "type": "text", "ai_description": "Clave 3-4 dígitos; normalmente la define el fedatario (null)." },
        "descripcion_alerta": { "type": "text" }
      }
    },
    "personas_aviso": {
      "type": "array",
      "item": {
        "nombre": { "type": "text", "required": true },
        "apellido_paterno": { "type": "text", "required": true },
        "apellido_materno": { "type": "text" },
        "fecha_nacimiento": { "type": "date" },
        "rfc": { "type": "text" },
        "curp": { "type": "text" }
      }
    },
    "operaciones": {
      "type": "array",
      "item": {
        "instrumento_publico": { "type": "text", "required": true },
        "fecha_operacion": { "type": "date", "required": true },
        "actividad": {
          "type": "object",
          "fields": {
            "poderdantes": {
              "type": "array",
              "ai_description": "Quien otorga el poder. tipo: fisica|moral|fideicomiso con sus campos (país y actividad/giro obligatorios).",
              "item": {
                "tipo": { "type": "text" },
                "nombre": { "type": "text" }, "apellido_paterno": { "type": "text" }, "apellido_materno": { "type": "text" },
                "fecha_nacimiento": { "type": "date" }, "rfc": { "type": "text" }, "curp": { "type": "text" },
                "denominacion_razon": { "type": "text" }, "fecha_constitucion": { "type": "date" }, "identificador_fideicomiso": { "type": "text" },
                "pais_nacionalidad": { "type": "select", "source": "catalogo_pais" },
                "actividad_economica": { "type": "select", "source": "catalogo_actividad_economica" },
                "giro_mercantil": { "type": "select", "source": "catalogo_giro_mercantil" }
              }
            },
            "apoderados": {
              "type": "array",
              "ai_description": "Quien recibe el poder. Incluye tipo_poder (1 administración, 2 dominio, 3 ambos). País obligatorio; no requiere actividad/giro.",
              "item": {
                "tipo_poder": { "type": "select", "source": "catalogo_tipo_poder", "required": true },
                "tipo": { "type": "text" },
                "nombre": { "type": "text" }, "apellido_paterno": { "type": "text" }, "apellido_materno": { "type": "text" },
                "fecha_nacimiento": { "type": "date" }, "rfc": { "type": "text" }, "curp": { "type": "text" },
                "denominacion_razon": { "type": "text" }, "fecha_constitucion": { "type": "date" }, "identificador_fideicomiso": { "type": "text" },
                "pais_nacionalidad": { "type": "select", "source": "catalogo_pais" }
              }
            }
          }
        }
      }
    }
  }
}
