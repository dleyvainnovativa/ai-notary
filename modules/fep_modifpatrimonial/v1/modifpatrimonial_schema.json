{
  "schema_version": "1.0.0",
  "global_rules": {
    "date_format": "YYYY-MM-DD",
    "number_format": "decimal",
    "normalization_rules": [
      "Return catalog values exactly as the catalog code (string).",
      "Remove currency symbols/separators from numbers.",
      "Convert dates to YYYY-MM-DD.",
      "Return null when missing; do not infer.",
      "Names/denominación in UPPERCASE without accents."
    ]
  },
  "fields": {
    "referencia_aviso": { "type": "text" },
    "prioridad": { "type": "select", "source": "catalogo_prioridad" },
    "alerta": { "type": "object", "fields": { "tipo_alerta": { "type": "text" }, "descripcion_alerta": { "type": "text" } } },
    "personas_aviso": {
      "type": "array",
      "item": { "nombre": { "type": "text", "required": true }, "apellido_paterno": { "type": "text", "required": true }, "apellido_materno": { "type": "text" }, "fecha_nacimiento": { "type": "date" }, "rfc": { "type": "text" }, "curp": { "type": "text" } }
    },
    "operaciones": {
      "type": "array",
      "item": {
        "instrumento_publico": { "type": "text", "required": true },
        "fecha_operacion": { "type": "date", "required": true },
        "actividad": {
          "type": "object",
          "fields": {
            "persona_moral_modifica": {
              "type": "object",
              "ai_description": "La persona moral cuyo patrimonio se modifica.",
              "fields": {
                "denominacion_razon": { "type": "text", "required": true },
                "fecha_constitucion": { "type": "date" },
                "rfc": { "type": "text" },
                "pais_nacionalidad": { "type": "select", "source": "catalogo_pais", "required": true },
                "giro_mercantil": { "type": "select", "source": "catalogo_giro_mercantil", "required": true },
                "numero_total_acciones": { "type": "number", "required": true },
                "motivo_modificacion": { "type": "select", "source": "catalogo_motivo_modificacion", "required": true, "ai_description": "1 Fusión, 2 Escisión, 3 Contrato privado." },
                "instrumento_publico": { "type": "text" }
              }
            },
            "datos_modificacion": {
              "type": "object",
              "fields": {
                "tipo_modificacion_capital_fijo": { "type": "select", "source": "catalogo_tipo_modificacion_capital", "required": true, "ai_description": "1 Aumento, 2 Disminución, 3 Sin modificación." },
                "inicial_capital_fijo": { "type": "number", "required": true },
                "final_capital_fijo": { "type": "number", "required": true },
                "tipo_modificacion_capital_variable": { "type": "select", "source": "catalogo_tipo_modificacion_capital", "required": true },
                "inicial_capital_variable": { "type": "number", "required": true },
                "final_capital_variable": { "type": "number", "required": true },
                "accionistas": {
                  "type": "array",
                  "ai_description": "Accionistas afectados (persona simple + numero_acciones).",
                  "item": {
                    "tipo": { "type": "text" },
                    "nombre": { "type": "text" }, "apellido_paterno": { "type": "text" }, "apellido_materno": { "type": "text" },
                    "fecha_nacimiento": { "type": "date" }, "rfc": { "type": "text" }, "curp": { "type": "text" },
                    "denominacion_razon": { "type": "text" }, "fecha_constitucion": { "type": "date" }, "identificador_fideicomiso": { "type": "text" },
                    "pais_nacionalidad": { "type": "select", "source": "catalogo_pais" },
                    "numero_acciones": { "type": "number", "required": true }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
