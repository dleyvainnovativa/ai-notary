{
  "schema_version": "1.0.0",
  "global_rules": {
    "date_format": "YYYY-MM-DD",
    "number_format": "decimal",
    "normalization_rules": [
      "Catalog values as the catalog code (string).",
      "Numbers without currency symbols/separators.",
      "Dates YYYY-MM-DD.",
      "null when missing; do not infer.",
      "Denominación in UPPERCASE without accents."
    ]
  },
  "fields": {
    "referencia_aviso": { "type": "text" },
    "prioridad": { "type": "select", "source": "catalogo_prioridad" },
    "alerta": { "type": "object", "fields": { "tipo_alerta": { "type": "text" }, "descripcion_alerta": { "type": "text" } } },
    "personas_aviso": { "type": "array", "item": { "nombre": { "type": "text", "required": true }, "apellido_paterno": { "type": "text", "required": true }, "apellido_materno": { "type": "text" }, "fecha_nacimiento": { "type": "date" }, "rfc": { "type": "text" }, "curp": { "type": "text" } } },
    "operaciones": {
      "type": "array",
      "item": {
        "instrumento_publico": { "type": "text", "required": true },
        "fecha_operacion": { "type": "date", "required": true },
        "actividad": {
          "type": "object",
          "fields": {
            "tipo_fusion": { "type": "select", "source": "catalogo_tipo_fusion", "required": true, "ai_description": "1 Absorción, 2 Integración." },
            "fusionadas": {
              "type": "array",
              "ai_description": "Sociedades que se fusionan (desaparecen). Bloque moral: denominacion_razon, fecha_constitucion, rfc, pais_nacionalidad, giro_mercantil, capital_social_fijo, capital_social_variable, folio_mercantil.",
              "item": {
                "denominacion_razon": { "type": "text", "required": true }, "fecha_constitucion": { "type": "date" }, "rfc": { "type": "text" },
                "pais_nacionalidad": { "type": "select", "source": "catalogo_pais", "required": true },
                "giro_mercantil": { "type": "select", "source": "catalogo_giro_mercantil", "required": true },
                "capital_social_fijo": { "type": "number", "required": true }, "capital_social_variable": { "type": "number" }, "folio_mercantil": { "type": "text" }
              }
            },
            "fusionante_determinadas": { "type": "text", "ai_description": "SI / NO." },
            "fusionante": {
              "type": "object",
              "ai_description": "Sociedad que subsiste. Mismo bloque moral + numero_total_acciones + accionistas[] (persona simple + numero_acciones).",
              "fields": {
                "denominacion_razon": { "type": "text" }, "fecha_constitucion": { "type": "date" }, "rfc": { "type": "text" },
                "pais_nacionalidad": { "type": "select", "source": "catalogo_pais" },
                "giro_mercantil": { "type": "select", "source": "catalogo_giro_mercantil" },
                "capital_social_fijo": { "type": "number" }, "capital_social_variable": { "type": "number" }, "folio_mercantil": { "type": "text" },
                "numero_total_acciones": { "type": "number" },
                "accionistas": {
                  "type": "array",
                  "item": {
                    "tipo": { "type": "text" }, "nombre": { "type": "text" }, "apellido_paterno": { "type": "text" }, "apellido_materno": { "type": "text" },
                    "fecha_nacimiento": { "type": "date" }, "rfc": { "type": "text" }, "curp": { "type": "text" },
                    "denominacion_razon": { "type": "text" }, "fecha_constitucion": { "type": "date" }, "identificador_fideicomiso": { "type": "text" },
                    "pais_nacionalidad": { "type": "select", "source": "catalogo_pais" }, "numero_acciones": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
