{
  "schema_version": "1.0.0",
  "global_rules": {
    "date_format": "YYYY-MM-DD",
    "number_format": "decimal",
    "normalization_rules": [
      "Return catalog values exactly as the catalog code (string).",
      "Remove currency symbols/separators from numbers.",
      "Convert dates to YYYY-MM-DD.",
      "Return null when missing; do not infer.",
      "Names in UPPERCASE without accents."
    ]
  },
  "fields": {
    "referencia_aviso": { "type": "text" },
    "prioridad": { "type": "select", "source": "catalogo_prioridad" },
    "alerta": {
      "type": "object",
      "fields": {
        "tipo_alerta": { "type": "text" },
        "descripcion_alerta": { "type": "text" }
      }
    },
    "personas_aviso": {
      "type": "array",
      "item": {
        "nombre": { "type": "text", "required": true },
        "apellido_paterno": { "type": "text", "required": true },
        "apellido_materno": { "type": "text" },
        "fecha_nacimiento": { "type": "date" }, "rfc": { "type": "text" }, "curp": { "type": "text" }
      }
    },
    "operaciones": {
      "type": "array",
      "item": {
        "instrumento_publico": { "type": "text", "required": true },
        "fecha_operacion": { "type": "date", "required": true },
        "actividad": {
          "type": "object",
          "fields": {
            "identificador_fideicomiso": { "type": "text", "ai_description": "Identificador del fideicomiso cuyos derechos se ceden." },
            "rfc": { "type": "text", "ai_description": "RFC (12) del fideicomiso." },
            "denominacion_razon": { "type": "text", "required": true, "ai_description": "Denominación del fideicomiso." },
            "tipo_cesion": { "type": "select", "source": "catalogo_tipo_cesion", "required": true, "ai_description": "3 fideicomitente oneroso, 4 fideicomitente gratuito, 5 fideicomisario oneroso, 6 fideicomisario gratuito." },
            "cedente": {
              "type": "object",
              "ai_description": "Quien cede los derechos (persona completa: país + actividad/giro).",
              "fields": {
                "tipo": { "type": "text" },
                "nombre": { "type": "text" }, "apellido_paterno": { "type": "text" }, "apellido_materno": { "type": "text" },
                "fecha_nacimiento": { "type": "date" }, "rfc": { "type": "text" }, "curp": { "type": "text" },
                "denominacion_razon": { "type": "text" }, "fecha_constitucion": { "type": "date" }, "identificador_fideicomiso": { "type": "text" },
                "pais_nacionalidad": { "type": "select", "source": "catalogo_pais" },
                "actividad_economica": { "type": "select", "source": "catalogo_actividad_economica" },
                "giro_mercantil": { "type": "select", "source": "catalogo_giro_mercantil" }
              }
            },
            "cesionario": {
              "type": "object",
              "ai_description": "Quien recibe los derechos (persona completa).",
              "fields": {
                "tipo": { "type": "text" },
                "nombre": { "type": "text" }, "apellido_paterno": { "type": "text" }, "apellido_materno": { "type": "text" },
                "fecha_nacimiento": { "type": "date" }, "rfc": { "type": "text" }, "curp": { "type": "text" },
                "denominacion_razon": { "type": "text" }, "fecha_constitucion": { "type": "date" }, "identificador_fideicomiso": { "type": "text" },
                "pais_nacionalidad": { "type": "select", "source": "catalogo_pais" },
                "actividad_economica": { "type": "select", "source": "catalogo_actividad_economica" },
                "giro_mercantil": { "type": "select", "source": "catalogo_giro_mercantil" }
              }
            },
            "monto_cesion": { "type": "number", "required": true, "ai_description": "Monto de la cesión en M.N." }
          }
        }
      }
    }
  }
}
